---
import { getServersPage } from '../../utils/d1';
import type { MCPServer } from '../../utils/d1';
import { staticServers } from '../../data/staticServers.js';
import ServerGrid from '../../components/ServerGrid';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { slug } = Astro.params;

const PRIMITIVE_DISPLAY: Record<string, string> = {
  tools: 'Tools',
  resources: 'Resources',
  prompts: 'Prompts',
  sampling: 'Sampling',
};

const primitiveName = PRIMITIVE_DISPLAY[slug || ''] || slug || 'Unknown';
const db = (Astro.locals as any).runtime?.env?.DB as D1Database | undefined;

let servers: MCPServer[] = [];
let total = 0;

if (db) {
  try {
    const result = await getServersPage(db, { primitives: [slug || ''], limit: 48 });
    servers = result.servers;
    total = result.total;
  } catch (error) {
    console.error(`Error fetching servers for primitive ${slug}:`, error);
  }
} else {
  // Fallback: filter by checking mcp_primitives on static data
  const all = staticServers as any[] as (MCPServer & { mcpPrimitives?: string[] })[];
  servers = all.filter(s => s.mcpPrimitives?.includes(slug || '')).slice(0, 48);
  total = servers.length;
}

const canonicalUrl = `https://www.mymcpshelf.com/primitives/${slug}`;
const pageTitle = `${primitiveName} MCP Servers | My MCP Shelf`;
const pageDescription = `Browse ${total}+ MCP servers that support the ${primitiveName} primitive. Find MCP servers with ${slug} capability.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${primitiveName} MCP Servers`,
  description: pageDescription,
  numberOfItems: total,
  itemListElement: servers.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: s.fields.name,
      description: s.fields.description,
      applicationCategory: 'DeveloperApplication',
      ...(s.fields.github_url && { codeRepository: s.fields.github_url }),
    },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl} structuredData={structuredData}>
  <div transition:name="main-content">
    <div class="hero-section">
      <div class="hero-content">
        <div class="breadcrumb">
          <a href="/">Home</a>
          <span>›</span>
          <span>Primitives</span>
          <span>›</span>
          <span>{primitiveName}</span>
        </div>
        <h1 class="page-title">{primitiveName} MCP Servers</h1>
        <p class="page-subtitle">MCP servers that provide the <strong>{primitiveName}</strong> primitive capability</p>
        <span class="server-count">{total} server{total !== 1 ? 's' : ''}</span>
      </div>
    </div>

    <div class="main-content">
      <div class="category-nav" style="margin-bottom: 2rem;">
        <a href="/primitives" class="category-link" style="font-weight: 500;">All Primitives</a>
        {Object.entries(PRIMITIVE_DISPLAY).map(([s, label]) => (
          <a
            href={`/primitives/${s}`}
            class:list={['category-link', { active: s === slug }]}
          >
            {label}
          </a>
        ))}
      </div>

      {servers.length > 0 ? (
        <ServerGrid
          client:load
          initialServers={servers}
          total={total}
          meta={{ primitives: slug }}
        />
      ) : (
        <div class="empty-state">
          <h2>No servers found for {primitiveName} primitive</h2>
          <p>Try <a href="/">browsing all servers</a> or check another primitive type.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
