---
// SSR: external_posts (Signal Field, Brainscriblr, etc.) are written to D1 at
// request time by Worker pipelines, never committed here — so this page can no
// longer be fully static. See src/utils/externalPosts.ts.
export const prerender = false;
import { getCollection } from 'astro:content';
import HeaderNewsletter from '../components/HeaderNewsletter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { NEWSLETTERS } from '../data/newsletters';
import { getExternalPosts } from '../utils/externalPosts';

const db = (Astro.locals as any).runtime?.env?.DB as D1Database | undefined;

const collectionPosts = (await getCollection('blog')).filter((post) => !post.data.draft);
const externalPosts = await getExternalPosts(db);

// Unify both sources into the shape the template already renders.
type BlogListItem = {
  slug: string;
  title: string;
  description: string;
  author: string;
  date: string | Date;
  track?: string;
  tags?: string[];
};

const posts: BlogListItem[] = [
  ...collectionPosts.map((post) => ({
    slug: post.slug,
    title: post.data.title,
    description: post.data.description,
    author: post.data.author,
    date: post.data.date,
    track: post.data.track,
    tags: post.data.tags,
  })),
  ...externalPosts.map((post) => ({
    slug: post.slug,
    title: post.title,
    description: post.description,
    author: post.author,
    date: post.published_at,
    track: post.track,
  })),
];

// Sort by date (newest first)
const sortedPosts = posts.sort((a, b) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Only offer filter chips for tracks that actually have posts
const activeTracks = NEWSLETTERS.filter((n) =>
  sortedPosts.some((post) => post.track === n.track)
);

const pageTitle = "My MCP Shelf Blog";

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: pageTitle,
  url: 'https://www.mymcpshelf.com/blog',
  description: 'Insights, updates, and guides for the MCP ecosystem',
  blogPost: sortedPosts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    datePublished: new Date(post.date).toISOString(),
    author: { '@type': 'Person', name: post.author },
    url: `https://www.mymcpshelf.com/blog/${post.slug}`,
  })),
};
---

<BaseLayout
  title={pageTitle}
  description="Insights, updates, and guides for the MCP ecosystem"
  canonical="https://www.mymcpshelf.com/blog"
  structuredData={structuredData}
>
  <div class="container">
    <section class="hero-section">
      <h1 class="hero-title">{pageTitle}</h1>
      <p class="hero-subtitle">Insights, updates, and guides for the MCP ecosystem</p>

      <div class="stats-bar">
        <div class="stat-item">
          <div class="stat-value">{sortedPosts.length}</div>
          <div class="stat-label">Articles</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">Weekly</div>
          <div class="stat-label">Updates</div>
        </div>
        <div class="stat-item">
          <div class="stat-value">Expert</div>
          <div class="stat-label">Authors</div>
        </div>
      </div>
    </section>

    <!-- Newsletter -->
    <div style="margin-top: 1.5rem; display: flex; justify-content: center;">
      <HeaderNewsletter />
    </div>

    <main>
      {activeTracks.length > 0 && (
        <div class="track-filter" role="group" aria-label="Filter posts by track">
          <button class="track-chip active" data-track="">All</button>
          {activeTracks.map((n) => (
            <button class="track-chip" data-track={n.track}>{n.name}</button>
          ))}
        </div>
      )}
      {sortedPosts.length > 0 ? (
        <div class="blog-grid">
          {sortedPosts.map((post) => (
            <article class="blog-card" data-track={post.track ?? ''}>
              <h3>
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>
              <div class="blog-meta">
                By {post.author} • {new Date(post.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </div>
              <p class="blog-description">
                {post.description}
              </p>
              {post.tags && (
                <div class="blog-tags">
                  {post.tags.map((tag: string) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        <p class="no-posts">No blog posts available yet. Check back soon!</p>
      )}
    </main>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero-section {
    text-align: center;
    margin-bottom: 2rem;
    padding: 2rem 0;
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, #f59e0b 0%, #3b82f6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: #000000;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .stats-bar {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1rem;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #b45309;
  }

  .stat-label {
    font-size: 0.9rem;
    color: #000000;
  }

  .track-filter {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .track-chip {
    background: #ffffff;
    color: #475569;
    border: 1px solid #e2e8f0;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .track-chip:hover {
    border-color: #f59e0b;
    color: #b45309;
  }

  .track-chip.active {
    background: rgba(245, 158, 11, 0.15);
    border-color: #f59e0b;
    color: #b45309;
    font-weight: 600;
  }

  .blog-card[hidden] {
    display: none;
  }

  .blog-grid {
    display: grid;
    gap: 2rem;
    margin-top: 2rem;
  }

  .blog-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid #e2e8f0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }

  .blog-card h3 {
    color: #0f172a;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .blog-card h3 a {
    text-decoration: none;
    color: inherit;
  }

  .blog-card h3 a:hover {
    color: #b45309;
  }

  .blog-meta {
    color: #475569;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .blog-description {
    color: #334155;
    margin-bottom: 1rem;
  }

  .blog-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    background: rgba(245, 158, 11, 0.15);
    color: #b45309;
    padding: 0.25rem 0.75rem;
    border-radius: 15px;
    font-size: 0.8rem;
  }

  .no-posts {
    text-align: center;
    color: #334155;
    font-size: 1.1rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .container { padding: 1rem; }
    .hero-title { font-size: 2rem; }
  }
</style>

<script>
  function initTrackFilter() {
    const chips = document.querySelectorAll<HTMLButtonElement>('.track-chip');
    if (chips.length === 0) return;
    const cards = document.querySelectorAll<HTMLElement>('.blog-card');

    function apply(track: string) {
      chips.forEach((chip) => chip.classList.toggle('active', chip.dataset.track === track));
      cards.forEach((card) => {
        card.hidden = track !== '' && card.dataset.track !== track;
      });
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const track = chip.dataset.track ?? '';
        const url = new URL(window.location.href);
        if (track) url.searchParams.set('track', track);
        else url.searchParams.delete('track');
        history.replaceState(null, '', url);
        apply(track);
      });
    });

    const initial = new URLSearchParams(window.location.search).get('track') ?? '';
    apply(initial);
  }

  initTrackFilter();
  document.addEventListener('astro:page-load', initTrackFilter);
</script>
