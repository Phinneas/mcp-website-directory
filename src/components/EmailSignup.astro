---
// Sitewide newsletter section — three-publication picker (Beehiiv).
// Publication data + embed URLs live in src/data/newsletters.ts.
import { NEWSLETTERS } from '../data/newsletters';
---

<div class="email-signup">
    <div class="signup-container">
        <h2 class="signup-heading">Three newsletters, one shelf</h2>
        <p class="signup-subheading">Pick the coverage you want — subscribers get new posts by email a day before they go live on the site.</p>
        <div class="pub-grid">
            {NEWSLETTERS.map((n) => (
                <a href={`/newsletters#${n.track}`} class="pub-card">
                    <h3 class="pub-name">{n.name}</h3>
                    <p class="pub-tagline">{n.tagline}</p>
                    <span class="pub-cta">Subscribe →</span>
                </a>
            ))}
        </div>
    </div>

    <!-- Custom MCP System CTA -->
    <div class="custom-mcp-cta">
        <div class="cta-content">
            <h3 class="cta-heading">Need a Custom MCP System?</h3>
            <p class="cta-text">Configuration & integration for your stack — from tool selection to production deployment. The directory recommends. The consultancy configures.</p>
            <a href="https://www.salishseaconsulting.com/contact/" class="cta-button btn btn-primary" target="_blank" rel="noopener noreferrer">
                Get Started →
            </a>
        </div>
    </div>
</div>

<style>
    .email-signup {
        background: linear-gradient(135deg, hsl(var(--primary)) 0%, hsl(var(--secondary)) 100%);
        padding: 3rem 2rem;
        margin: 4rem 0;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .signup-container {
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
    }

    .signup-heading {
        font-size: 1.6rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.5rem;
        font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .signup-subheading {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 1.75rem;
    }

    .pub-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
    }

    .pub-card {
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 12px;
        padding: 1.25rem;
        text-decoration: none;
        text-align: left;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .pub-card:hover {
        transform: translateY(-3px);
        background: rgba(0, 0, 0, 0.35);
        border-color: rgba(255, 255, 255, 0.35);
    }

    .pub-name {
        color: #ffffff;
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0;
    }

    .pub-tagline {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
        margin: 0;
        flex: 1;
    }

    .pub-cta {
        color: #ffffff;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .custom-mcp-cta {
        max-width: 600px;
        margin: 2rem auto 0;
        padding: 1.5rem;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .cta-content {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .cta-heading {
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
        font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .cta-text {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
        line-height: 1.5;
        max-width: 400px;
    }

    .cta-button {
        padding: 0.75rem 1.5rem;
        background: #ffffff;
        color: #333;
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        background: #f8fafc;
    }

    .btn {
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary {
        background: #ffffff;
        color: #333;
    }

    @media (max-width: 768px) {
        .pub-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .email-signup {
            padding: 2rem 1.5rem;
            margin: 2rem 0;
        }

        .custom-mcp-cta {
            margin: 1.5rem auto 0;
            padding: 1.25rem;
        }

        .cta-heading {
            font-size: 1.1rem;
        }

        .cta-text {
            font-size: 0.9rem;
        }
    }
</style>
