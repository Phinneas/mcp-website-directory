---
// Compact newsletter CTA pill — links to the publication picker.
// (Replaced a fake email form that only console.logged the address.)
---

<div class="header-newsletter">
    <span class="newsletter-label">📬 Three newsletters: OpenSourceScribes · Signal Field · AI Horizons Dispatch</span>
    <a href="/newsletters" class="subscribe-btn">Subscribe</a>
</div>

<style>
    .header-newsletter {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 0.75rem 1.5rem;
        background: hsl(var(--card));
        border-radius: 50px;
        border: 1px solid hsl(var(--border));
    }

    .newsletter-label {
        color: hsl(var(--foreground));
        font-size: 0.9rem;
        font-weight: 500;
    }

    .subscribe-btn {
        padding: 0.5rem 1.25rem;
        background: hsl(var(--primary));
        color: white;
        border: none;
        border-radius: 25px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .subscribe-btn:hover {
        background: hsl(var(--primary) / 0.9);
        transform: translateY(-1px);
    }

    @media (max-width: 768px) {
        .header-newsletter {
            flex-direction: column;
            align-items: stretch;
            padding: 1rem;
            border-radius: 15px;
            text-align: center;
        }

        .subscribe-btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
